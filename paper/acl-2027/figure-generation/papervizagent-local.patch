+async def call_text_with_retry_async(
+    model_name, contents, config, max_attempts=5, retry_delay=5, error_context=""
+):
+    """Use the selected provider without changing the diagram agent pipeline."""
+    if model_name.startswith("gpt-") and not model_name.startswith("gpt-image"):
+        return await call_openai_with_retry_async(
+            model_name, contents, {
+                "system_prompt": config.system_instruction or "",
+                "temperature": config.temperature,
+                "candidate_num": config.candidate_count or 1,
+                "max_completion_tokens": config.max_output_tokens,
+            }, max_attempts=max_attempts, retry_delay=retry_delay, error_context=error_context,
+        )
+    if not model_name.startswith("gemini"):
+        raise ValueError(f"Unsupported text model: {model_name}")
+    return await call_gemini_with_retry_async(
+        model_name, contents, config, max_attempts=max_attempts,
+        retry_delay=retry_delay, error_context=error_context,
+    )
