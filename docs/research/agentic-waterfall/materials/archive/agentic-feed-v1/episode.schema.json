              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "metadata": {
            "properties": {
              "data_origin": {
                "const": "synthetic"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "metadata": {
            "properties": {
              "simulator": {
                "type": "object"
              }
            }
          }
        }
      }
    }
  ]
}
